NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=nebula-data-plus
JWT_AUDIENCE=nebula-data-plus-web
COOKIE_NAME=nebula_session

# Secure server-side admin provisioning. Generate an Argon2id hash; never store the plaintext password here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Payment provider secrets belong here ONLY and are never sent to the browser.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=
MOMO_API_KEY=
MOMO_API_SECRET=

# Optional automatic data-delivery provider endpoints. Keep secrets server-side.
DELIVERY_PROVIDER_URL=
DELIVERY_PROVIDER_SECRET=
DELIVERY_PROVIDER_URL_2=
DELIVERY_PROVIDER_SECRET_2=
MAX_DELIVERY_ATTEMPTS=5

# Optional notification webhooks (connect these to your WhatsApp/SMS provider).
WHATSAPP_WEBHOOK_URL=
SMS_WEBHOOK_URL=

# MTN number eligibility checker (server-side only)
MTN_VERIFICATION_URL=
MTN_VERIFICATION_SECRET=

# Automatic customer delivery notifications
# WhatsApp Cloud API (Meta). Create/approve a utility delivery template first.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DELIVERY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Optional generic WhatsApp adapter if you use another provider instead of Meta.
WHATSAPP_WEBHOOK_URL=

# SMS: Hubtel or a generic SMS webhook. For Hubtel set the URL supplied by your account/API docs.
HUBTEL_SMS_URL=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Nebula
SMS_WEBHOOK_URL=
